# Copy to .env and adjust. docker compose reads .env automatically.

# Host port the reverse proxy forwards to.
HOST_PORT=9080

# Host directory holding credentials.json and content/. Back this up.
DATA_PATH=./data

# Session cookies are marked Secure by default, which requires HTTPS.
# Set to false ONLY to try the app over plain http:// on a local machine.
COOKIE_SECURE=true

# Leave both blank for the normal flow: the first visit shows a setup screen
# where you create the first administrator in the browser.
#
# Set BOTH for unattended deployments and that account is seeded on first
# start instead, skipping the setup screen. Ignored once any user exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=
