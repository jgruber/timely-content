# Copy to .env and adjust. docker compose reads .env automatically.

# Host port the reverse proxy forwards to.
HOST_PORT=9080

# Host directory holding credentials.json and content/. Back this up.
DATA_PATH=./data

# Session cookies are marked Secure by default, which requires HTTPS.
# Set to false ONLY to try the app over plain http:// on a local machine.
COOKIE_SECURE=true

# ---- Required -------------------------------------------------------------
# The service will not start without these while password reset is enabled,
# and the log explains exactly what to set.

# The address people actually reach this server on. QR codes and password
# reset links are built from it. Never derived from the request, because a
# forged Host header could redirect a reset link to an attacker.
PUBLIC_URL=

# Mail relay used for password resets and address confirmation.
SMTP_HOST=
SMTP_FROM=no-reply@example.com

# ---- Optional SMTP --------------------------------------------------------
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=

# Set false to run with no mail server. The forgot-password link is hidden and
# new accounts are usable without confirming their address.
PASSWORD_RESET_ENABLED=true

# ---- Optional overrides ---------------------------------------------------
# Anything in settings.json can be set here instead; the environment wins.
# SITE_NAME=
# DEFAULT_MODE=system
# DEFAULT_ACCENT=indigo
# ENFORCE_HOST=false
# MAX_UPLOAD_MB=25
# SESSION_HOURS=12
# RESET_TOKEN_MINUTES=30

# ---- First run ------------------------------------------------------------
# Leave blank for the setup screen on first visit. Set BOTH to seed the first
# administrator unattended. Ignored once any account exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
